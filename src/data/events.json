                "type": "temp",
                "label": "Late night",
                "games": 1,
                "modifiers": [
                  {
                    "stat": "topSpeedScale",
                    "op": "mul",
                    "value": 0.96
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "label": "Send your regrets",
        "outcomes": [
          {
            "result": "An early night. Nothing gained, nothing lost.",
            "effects": []
          }
        ]
      }
    ]
  },
  {
    "id": "extra-practice",
    "title": "Extra practice",
