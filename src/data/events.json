        "label": "Let him talk about the youngsters",
        "outcomes": [
          {
            "result": "The kids sit up straighter. Your weakest dressed player lifts his game for the season.",
            "effects": [
              {
                "type": "bump",
                "who": "worst",
                "amount": 4
