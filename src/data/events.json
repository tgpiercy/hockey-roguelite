[
  {
    "id": "bus-breakdown",
    "title": "The bus breaks down",
    "text": "Two hours from the rink, the team bus gives up. A local garage can fix it fast for a price, or the players can push on by foot and thumb.",
    "choices": [
      {
        "label": "Pay the garage (25 currency)",
        "outcomes": [
          {
            "result": "The bus is rolling again within the hour. Everyone arrives rested.",
            "effects": [
              {
                "type": "currency",
                "amount": -25
              }
            ]
          }
        ]
      },
      {
        "label": "Walk it",
        "outcomes": [
          {
            "result": "They make it, but on heavy legs. Your skaters tire faster next game.",
            "effects": [
              {
                "type": "temp",
                "label": "Heavy legs",
                "games": 1,
                "modifiers": [
                  {
                    "stat": "drainScale",
                    "op": "mul",
                    "value": 1.4
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "sponsor-dinner",
    "title": "Sponsor dinner",
    "text": "A local sponsor wants the whole team at a long dinner the night before a game.",
    "choices": [
      {
        "label": "Go, and collect the cheque",
        "outcomes": [
          {
            "result": "A late night, a fat cheque. The team is a step slow next game.",
